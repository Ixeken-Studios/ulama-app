    <string name="settings_about_changelog_feat8_title">New competitions hub</string>
    <string name="settings_about_changelog_feat8_desc">Complete redesign to choose leagues, browse regions on the world map, and follow favorite teams in one place.</string>
    <string name="settings_about_changelog_feat6_title">Lineups, events, and icons</string>
    <string name="settings_about_changelog_feat6_desc">Card, goal, and assist icons in lineups, Starting and Final match views, a new Events tab, and icons across all match detail tabs.</string>
    <string name="settings_about_changelog_feat7_title">More gestures and bug fixes</string>
    <string name="settings_about_changelog_feat7_desc">Swipe gestures on the home screen to switch leagues and dates and across match detail tabs, plus automatic live refresh and fixes for knockout brackets, scores, and two-legged ties.</string>
    <string name="settings_about_changelog_feat4_title">Cards in lineups and stability</string>
    <string name="settings_about_changelog_feat4_desc">Yellow, second yellow, and red cards on the pitch and substitutes, plus improvements to schedules, brackets, and auto-follow.</string>
